# Server
PORT=5025
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/crm
REDIS_URI=redis://127.0.0.1:6379

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:3025

# Logging
LOG_LEVEL=info

# Seed (admin account created on first run)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123

# SMTP Config
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@luvid.in

# Optional: override upload size limits (bytes)
# MAX_IMAGE_SIZE=5242880
# MAX_PROOF_SIZE=10485760
# MAX_AUDIO_SIZE=5242880

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

